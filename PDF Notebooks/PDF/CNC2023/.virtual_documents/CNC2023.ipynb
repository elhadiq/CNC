import numpy as np
import matplotlib.pyplot as plt





def decoupe(P):
    p=np.array(P)
    return p[:,0],p[:,1]


def decoupe2(P):
    X,Y=[],[]
    for x,y in P:
        X.append(x)
        Y.append(y)
    return X,Y


P=np.array([(-1,2),(0,1),(5,4),(1,3),(-2,8),(-7,3),(3,-3)])
decoupe(P)


X,Y=decoupe2(P)





def matrice(X):
    n=len(X)
    M=np.zeros((n,n),dtype=int)
    M[:,0]=1
    for i in range(1,n):
        for j in range(1,i+1):
            M[i,j]=int((X[i]-X[j-1])*M[i,j-1])
    return M


X=[-1,0,5,1,-2,-7,3]
M=matrice(X);M





def solution(M,Y):
    X=[1]
    for i in range(1,len(Y)):
        X.append((Y[i]-M[i,:i]@X[:i])/M[i,i])
    return X


A=solution(M,Y);A





def valeur(x,A,X):
    s=0;n=len(X)
    for i in range(n):
        p=1
        for j in range(i):
            p*=x-X[j]
        s+=A[i]*p
    return s





def courbe(P):
    X,Y=decoupe(P)
    M=matrice(X)
    A=solution(M,Y)
    t=np.linspace(min(X),max(X),500)
    yt=[valeur(tt,A,X) for tt in t]
    plt.scatter(X,Y)
    plt.plot(t,yt)


courbe(P)














def non1(X):
    trans={ord('0'):ord('1'),ord('1'):ord('0')}
    Z=X[:]
    Z=Z.translate(trans)
    return Z


non1("010101")


def non2(X):
    return "".join(['1' if x=='0' else '0' for x in X])


non2('010101')


def non3(X):
    Z=""
    for x in X:
        Z+='1' if x=='0' else '0'
    return Z


